# ── CareBridge environment ──────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file.

# Required: at least 32 random characters. Used to sign JWT tokens.
JWT_SECRET=

# Required (non-demo): admin account seeded on first run.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Get a key at https://console.groq.com
GROQ_API_KEY=

# 1 = use hand-written fixtures for the sample summaries (no key, no network).
# With no key set, mock mode is used automatically.
MOCK_LLM=0

# 1 = demo mode with pre-loaded accounts. Never use in production.
# DEMO=0
