# Get a key at https://console.groq.com. Never commit the real .env file.
GROQ_API_KEY=
# 1 = use hand-written fixtures for the sample summaries (no key, no network).
# With no key set, mock mode is used automatically.
MOCK_LLM=0
# Optional. Voice reads already approved text aloud (text to speech only).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Set a long random value for anything beyond a demo.
JWT_SECRET=
